{
  "name": "@tianjos/eslint-plugin-elegant",
  "version": "0.10.1",
  "description": "Opinionated ESLint rules for elegant, behavior-rich TypeScript: honest types, encapsulated state, small uncoupled classes, guard-clause flow, and structured logging. Built for NestJS and DDD codebases.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "typescript",
    "nestjs",
    "code-quality",
    "linting"
  ],
  "author": "Thiago <thiago@bullcredtech.com>",
  "license": "MIT",
  "homepage": "https://github.com/tianjos/eslint-plugin-elegant#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianjos/eslint-plugin-elegant.git"
  },
  "bugs": {
    "url": "https://github.com/tianjos/eslint-plugin-elegant/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "npm run build && eslint .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run build && jest",
    "release": "commit-and-tag-version --release-as minor",
    "release:patch": "commit-and-tag-version --release-as patch",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.0.0"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": ">=8",
    "eslint": ">=9",
    "typescript": ">=5 <6.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/rule-tester": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "commit-and-tag-version": "^13.2.1",
    "eslint": "^10.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
